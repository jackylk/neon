@@ -29,6 +29,58 @@ use tantivy::schema::Schema;
 use tantivy::{Index, IndexSettings};
 use tokenizers::SearchTokenizer;
 
+/// Neon compatibility: FFI declarations for Neon's unlogged build hooks.
+///
+/// Neon's disaggregated storage requires all persistent data to go through WAL.
+/// During index builds, PostgreSQL normally skips WAL-logging and logs everything
+/// at the end. Neon's pageserver cannot reconstruct evicted pages without WAL,
+/// causing "zero LSN" PANIC. These hooks redirect writes to local storage during
+/// the build phase, then WAL-log everything at the end.
+#[cfg(feature = "neon")]
+pub(crate) mod neon_compat {
+    use pgrx::pg_sys;
+
+    extern "C" {
+        // Neon-specific unlogged build hooks (from neon's smgr.h)
+        pub fn smgr_start_unlogged_build(reln: pg_sys::SMgrRelation);
+        pub fn smgr_finish_unlogged_build_phase_1(reln: pg_sys::SMgrRelation);
+        pub fn smgr_end_unlogged_build(reln: pg_sys::SMgrRelation);
+
+        // Standard PG functions that pgrx may not bind
+        fn smgropen(
+            rlocator: pg_sys::RelFileLocator,
+            backend: pg_sys::ProcNumber,
+            relpersistence: std::ffi::c_char,
+        ) -> pg_sys::SMgrRelation;
+        fn smgrpin(reln: pg_sys::SMgrRelation);
+        pub fn log_newpage_range(
+            rel: pg_sys::Relation,
+            forknum: i32,  // pg_sys::ForkNumber is a module in pgrx, underlying type is i32
+            startblk: pg_sys::BlockNumber,
+            endblk: pg_sys::BlockNumber,
+            page_std: bool,
+        );
+    }
+
+    /// Ensure the relation's SMgrRelation is open and return it.
+    pub unsafe fn relation_get_smgr(rel: pg_sys::Relation) -> pg_sys::SMgrRelation {
+        if (*rel).rd_smgr.is_null() {
+            (*rel).rd_smgr = smgropen(
+                (*rel).rd_locator,
+                (*rel).rd_backend,
+                (*(*rel).rd_rel).relpersistence,
+            );
+            smgrpin((*rel).rd_smgr);
+        }
+        (*rel).rd_smgr
+    }
+
+    /// Check if the relation needs WAL logging (i.e., is permanent).
+    pub unsafe fn relation_needs_wal(rel: pg_sys::Relation) -> bool {
+        (*(*rel).rd_rel).relpersistence == pg_sys::RELPERSISTENCE_PERMANENT as i8
+    }
+}
