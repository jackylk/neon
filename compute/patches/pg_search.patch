+// Neon: GenericXLog WAL support for all buffer modifications.
+// GenericXLog records page-level diffs so Neon's pageserver can reconstruct pages from WAL.
+#[cfg(feature = "neon")]
+mod neon_xlog {
+    use pgrx::pg_sys;
+
+    /// Opaque state for GenericXLog (PG doesn't expose the struct layout)
+    #[repr(C)]
+    pub struct GenericXLogState {
+        _opaque: [u8; 0],
+    }
+
+    pub const GENERIC_XLOG_FULL_IMAGE: i32 = 0x0001;
+
+    extern "C" {
+        pub fn GenericXLogStart(relation: pg_sys::Relation) -> *mut GenericXLogState;
+        pub fn GenericXLogRegisterBuffer(
+            state: *mut GenericXLogState,
+            buffer: pg_sys::Buffer,
+            flags: i32,
+        ) -> pg_sys::Page;
+        pub fn GenericXLogFinish(state: *mut GenericXLogState) -> pg_sys::XLogRecPtr;
+        pub fn GenericXLogAbort(state: *mut GenericXLogState);
+    }
+}
+
+#[cfg(feature = "neon")]
+struct NeonXLogCtx {
+    state: *mut neon_xlog::GenericXLogState,
+    shadow_page: pg_sys::Page,
+}
+
+/// Construct a BufferMut with proper Neon fields.
+/// Usage: `new_buffer_mut!(pg_buffer, relation_expr)` where relation_expr is a pg_sys::Relation.
+macro_rules! new_buffer_mut {
+    ($pg_buffer:expr, $relation:expr) => {
+        BufferMut {
+            dirty: false,
+            inner: Buffer::new($pg_buffer),
+            #[cfg(feature = "neon")]
+            relation: $relation,
+            #[cfg(feature = "neon")]
+            xlog: None,
+        }
+    };
+    // Variant for Buffer { pg_buffer } (non-new_buffer constructor)
+    (raw $pg_buffer:expr, $relation:expr) => {
+        BufferMut {
+            dirty: false,
+            inner: Buffer { pg_buffer: $pg_buffer },
+            #[cfg(feature = "neon")]
+            relation: $relation,
+            #[cfg(feature = "neon")]
+            xlog: None,
+        }
+    };
+}
