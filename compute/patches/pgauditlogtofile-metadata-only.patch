+
+/* Lakeon metadata mode must not export diagnostic SQL or user-controlled
+ * line breaks. Keep the upstream full-audit format when statement logging
+ * is explicitly enabled. */
+static bool lakeon_metadata_only(void)
+{
+  const char *setting = GetConfigOption("pgaudit.log_statement", true, false);
+  return setting == NULL || strcmp(setting, "off") == 0;
+}
+
+static bool lakeon_native_audit_origin(const ErrorData *edata)
+{
+  const char *filename;
+  if (edata->filename == NULL)
+    return false;
+  filename = strrchr(edata->filename, '/');
+  filename = filename == NULL ? edata->filename : filename + 1;
+  return strcmp(filename, "pgaudit.c") == 0;
+}
+
+static void lakeon_escape_metadata_line(StringInfo buf)
+{
+  StringInfoData safe;
+  int i;
+  initStringInfo(&safe);
+  for (i = 0; i < buf->len; i++)
+  {
+    unsigned char c = (unsigned char) buf->data[i];
+    if (c == '\\')
+      appendStringInfoString(&safe, "\\\\");
+    else if (c == '\n')
+      appendStringInfoString(&safe, "\\n");
+    else if (c == '\r')
+      appendStringInfoString(&safe, "\\r");
+    else if (c == '\t')
+      appendStringInfoString(&safe, "\\t");
+    else if (c < 32 || c == 127)
+      appendStringInfo(&safe, "\\x%02x", c);
+    else
+      appendStringInfoCharMacro(&safe, c);
+  }
+  resetStringInfo(buf);
+  appendBinaryStringInfo(buf, safe.data, safe.len);
+  pfree(safe.data);
+}
 
